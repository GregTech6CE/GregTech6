{
  "multipart": [
    {
      "when": {
        "mode": "wall",
        "facing": "down"
      },
      "apply": {
        "model": "gt6ce:block/decoration/spike_wall_down"
      }
    },
    {
      "when": {
        "mode": "wall",
        "facing": "up"
      },
      "apply": {
        "model": "gt6ce:block/decoration/spike_wall_up"
      }
    },
    {
      "when": {
        "mode": "wall",
        "facing": "north"
      },
      "apply": {
        "model": "gt6ce:block/decoration/spike_wall_north"
      }
    },
    {
      "when": {
        "mode": "wall",
        "facing": "south"
      },
      "apply": {
        "model": "gt6ce:block/decoration/spike_wall_south"
      }
    },
    {
      "when": {
        "mode": "wall",
        "facing": "west"
      },
      "apply": {
        "model": "gt6ce:block/decoration/spike_wall_west"
      }
    },
    {
      "when": {
        "mode": "wall",
        "facing": "east"
      },
      "apply": {
        "model": "gt6ce:block/decoration/spike_wall_east"
      }
    },
    {
      "when": {
        "mode": "omni"
      },
      "apply": {
        "model": "gt6ce:block/decoration/spike_omni"
      }
    },
    {
      "when": {
        "mode": "falling"
      },
      "apply": {
        "model": "gt6ce:block/decoration/spike_omni"
      }
    }
  ]
}
